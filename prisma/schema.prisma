// NUSWORD Prisma schema
// learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single user (Phase 2: single-user, no auth yet).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Canonical document — the source of truth for a publication.
/// Content is stored as Tiptap/ProseMirror JSON (structured, not raw HTML).
/// Settings hold page/layout configuration as a JSON string.
model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  /// Tiptap JSON document (stringified). See PRD §13 Canonical Document Model.
  content   String   @default("")
  /// PageSettings JSON (stringified): pageSize, orientation, margins, bleed, languageDirection.
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete: documents go to trash before permanent deletion (PRD §25).
  deletedAt DateTime?

  versions  DocumentVersion[]
  exportJobs ExportJob[]

  @@index([deletedAt])
  @@index([updatedAt])
}

/// Immutable document version snapshot (PRD §13: "Keep document versions
/// immutable so users can restore previous states").
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Snapshot of the Tiptap JSON content at version creation time.
  content    String
  /// Snapshot of PageSettings JSON at version creation time.
  settings   String
  /// Sequential version number per document.
  version    Int
  /// Optional human-readable label (e.g. "Before AI rewrite").
  message    String?
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

/// Export job — tracks PDF/DOCX/HTML/SVG/PNG generation (PRD §16).
/// Every export creates a job with progress state, artifact metadata,
/// checksum and retention policy.
model ExportJob {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Output format: "pdf" | "docx" | "html" | "svg" | "png"
  format       String
  /// Print preset: "screen" | "standard" | "highquality" | "booklet" | "custom"
  preset       String   @default("standard")
  /// Job status: "pending" | "processing" | "completed" | "failed"
  status       String   @default("pending")
  /// Path to the generated artifact file (relative to exports dir).
  artifactPath String?
  /// File size in bytes.
  artifactSize Int?
  /// SHA-256 checksum of the artifact.
  checksum     String?
  /// JSON-stringified preflight report (PRD §16: preflight before print).
  preflightReport String?
  /// Error message if status === "failed".
  errorMessage String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  /// Retention: when the artifact expires and can be deleted (PRD §25).
  expiresAt    DateTime?

  @@index([documentId])
  @@index([status])
}

/// Book — a collection of chapters with front/back matter, trim size,
/// binding intent, and print profile (PRD §15: Book & Kitab Architecture).
/// A Book owns metadata, chapter references, and book-specific page settings.
model Book {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Book")
  subtitle    String?
  author      String?
  /// Book-specific settings (JSON): trimSize, binding, mirrorMargins, runningHeaders, etc.
  settings    String   @default("{}")
  /// Front matter config (JSON): array of {type, title, content} entries.
  frontMatter String   @default("[]")
  /// Back matter config (JSON): array of {type, title, content} entries.
  backMatter  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  chapters BookChapter[]

  @@index([deletedAt])
  @@index([updatedAt])
}

/// BookChapter — a chapter in a book's chapter tree (PRD §15: nested chapters
/// and ordering). Each chapter references a Document (the chapter content).
model BookChapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The document containing this chapter's content.
  documentId String?
  /// Chapter title (may differ from document title).
  title      String   @default("Untitled Chapter")
  /// Sort order within the parent (0-based).
  sortOrder  Int      @default(0)
  /// Parent chapter id (null = top-level chapter). Enables nested chapters.
  parentId   String?
  /// Whether this chapter starts on a new page (default true for books).
  startNewPage Boolean @default(true)
  /// Whether to include this chapter in the TOC.
  includeInToc Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([parentId])
  @@index([sortOrder])
}
