// NUSWORD Prisma schema
// learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL — Neon serverless (recommended for Vercel deployment).
  //
  // Neon provides TWO connection strings:
  //  - Pooled (DATABASE_URL): for the app runtime (connection pooling, port 5432)
  //  - Direct  (DIRECT_URL):   for Prisma migrations (bypasses pooler)
  //
  // Both use SSL (sslmode=require) — Neon requires it.
  //
  // Set both in .env (see .env.example for format).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A registered user.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// Bcrypt password hash (null for OAuth-only users in the future).
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Canonical document — the source of truth for a publication.
/// Content is stored as Tiptap/ProseMirror JSON (structured, not raw HTML).
/// Settings hold page/layout configuration as a JSON string.
model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  /// Tiptap JSON document (stringified). See PRD §13 Canonical Document Model.
  content   String   @default("")
  /// PageSettings JSON (stringified): pageSize, orientation, margins, bleed, languageDirection.
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft-delete: documents go to trash before permanent deletion (PRD §25).
  deletedAt DateTime?
  /// Owner email — used for user isolation (each user sees only their documents).
  ownerEmail String?
  /// Organization that owns this document (null = personal).
  organizationId String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  versions  DocumentVersion[]
  exportJobs ExportJob[]
  shares    SharedDocument[]

  @@index([deletedAt])
  @@index([updatedAt])
  @@index([organizationId])
  @@index([ownerEmail])
}

/// Immutable document version snapshot (PRD §13: "Keep document versions
/// immutable so users can restore previous states").
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Snapshot of the Tiptap JSON content at version creation time.
  content    String
  /// Snapshot of PageSettings JSON at version creation time.
  settings   String
  /// Sequential version number per document.
  version    Int
  /// Optional human-readable label (e.g. "Before AI rewrite").
  message    String?
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

/// Export job — tracks PDF/DOCX/HTML/SVG/PNG generation (PRD §16).
/// Every export creates a job with progress state, artifact metadata,
/// checksum and retention policy.
model ExportJob {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Output format: "pdf" | "docx" | "html" | "svg" | "png"
  format       String
  /// Print preset: "screen" | "standard" | "highquality" | "booklet" | "custom"
  preset       String   @default("standard")
  /// Job status: "pending" | "processing" | "completed" | "failed"
  status       String   @default("pending")
  /// Path to the generated artifact file (relative to exports dir).
  artifactPath String?
  /// File size in bytes.
  artifactSize Int?
  /// SHA-256 checksum of the artifact.
  checksum     String?
  /// JSON-stringified preflight report (PRD §16: preflight before print).
  preflightReport String?
  /// Error message if status === "failed".
  errorMessage String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  /// Retention: when the artifact expires and can be deleted (PRD §25).
  expiresAt    DateTime?

  @@index([documentId])
  @@index([status])
}

/// Book — a collection of chapters with front/back matter, trim size,
/// binding intent, and print profile (PRD §15: Book & Kitab Architecture).
/// A Book owns metadata, chapter references, and book-specific page settings.
model Book {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Book")
  subtitle    String?
  author      String?
  /// Book-specific settings (JSON): trimSize, binding, mirrorMargins, runningHeaders, etc.
  settings    String   @default("{}")
  /// Front matter config (JSON): array of {type, title, content} entries.
  frontMatter String   @default("[]")
  /// Back matter config (JSON): array of {type, title, content} entries.
  backMatter  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  /// Owner email — used for user isolation.
  ownerEmail  String?
  /// Organization that owns this book (null = personal).
  organizationId String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  chapters BookChapter[]

  @@index([deletedAt])
  @@index([updatedAt])
  @@index([organizationId])
  @@index([ownerEmail])
}

/// BookChapter — a chapter in a book's chapter tree (PRD §15: nested chapters
/// and ordering). Each chapter references a Document (the chapter content).
model BookChapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The document containing this chapter's content.
  documentId String?
  /// Chapter title (may differ from document title).
  title      String   @default("Untitled Chapter")
  /// Sort order within the parent (0-based).
  sortOrder  Int      @default(0)
  /// Parent chapter id (null = top-level chapter). Enables nested chapters.
  parentId   String?
  /// Whether this chapter starts on a new page (default true for books).
  startNewPage Boolean @default(true)
  /// Whether to include this chapter in the TOC.
  includeInToc Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([parentId])
  @@index([sortOrder])
}

/// Organization — a team/workspace that owns documents and books (PRD §19: RBAC).
/// Phase 7: organizations without billing. Used for sharing and collaboration.
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members     OrganizationMember[]
  documents   Document[]
  books       Book[]
  templates   Template[]

  @@index([deletedAt])
}

/// Organization membership with role (PRD §19: RBAC roles).
model OrganizationMember {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Member email (Phase 7: no auth yet, identified by email).
  email           String
  /// Display name.
  name            String?
  /// Role: "owner" | "admin" | "editor" | "commenter" | "viewer"
  role            String   @default("viewer")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

/// Shared document — grants access to a document for a user/org (PRD §19).
/// Sharing is separate from ownership: a document can be owned by an org and
/// shared with individual users.
model SharedDocument {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Who the document is shared with (email).
  sharedWithEmail String
  /// Role granted to the sharee: "editor" | "commenter" | "viewer"
  role         String   @default("viewer")
  /// Optional share token for public link sharing.
  shareToken   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@index([sharedWithEmail])
}

/// Template — a reusable document/book template (PRD §7: Template Engine).
/// Templates can be published to the marketplace for others to use.
model Template {
  id           String   @id @default(cuid())
  title        String
  description  String?
  /// "document" | "book"
  type         String   @default("document")
  /// Category: "academic" | "business" | "creative" | "religious" | "personal"
  category     String   @default("personal")
  /// Tiptap JSON content (for document templates).
  content      String   @default("")
  /// PageSettings or BookSettings JSON.
  settings     String   @default("{}")
  /// Whether this template is published to the marketplace.
  published    Boolean  @default(false)
  /// Organization that owns this template (null = system template).
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Usage count (how many times this template was used).
  useCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@index([organizationId])
}

/// Usage event — tracks user activity for metering (PRD §32: success metrics).
/// Phase 7: tracking only, no billing. Used for analytics and limits.
model UsageEvent {
  id          String   @id @default(cuid())
  /// User email (Phase 7: no auth).
  email       String
  /// Event type: "document.create" | "document.export" | "book.create" | "template.use" | etc.
  type        String
  /// Resource ID (document id, book id, etc.).
  resourceId  String?
  /// Additional metadata (JSON).
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([type])
  @@index([createdAt])
}
