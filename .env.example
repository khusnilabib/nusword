# NUSWORD Environment Variables
#
# Copy this file to .env and fill in your values.
# The app supports THREE auth modes (checked in order):
#   1. Encore (if NEXT_PUBLIC_API_BASE_URL is set) — JWT auth via Encore backend
#   2. Supabase (if NEXT_PUBLIC_SUPABASE_URL is set) — Supabase auth
#   3. Next.js (default) — cookie-based JWT auth via /api/auth/* routes

# ─── Database (Neon PostgreSQL — REQUIRED for production) ──────────────
#
# Neon provides two connection strings (Settings → Connection Details):
#
# 1. DATABASE_URL — Pooled connection (for app runtime):
#    Used by Prisma Client in the running application.
#    Contains "-pooler" in the hostname.
#
# 2. DIRECT_URL — Direct connection (for migrations):
#    Used by Prisma Migrate / db push. Does NOT contain "-pooler".
#
# Format:
# DATABASE_URL=postgresql://[user]:[password]@ep-[id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://[user]:[password]@ep-[id].[region].aws.neon.tech/[dbname]?sslmode=require
#
# Local dev (Docker PostgreSQL):
# DATABASE_URL=postgresql://nusword:nusword@localhost:5432/nusword
# DIRECT_URL=postgresql://nusword:nusword@localhost:5432/nusword
#
# After setting DATABASE_URL + DIRECT_URL, run:
#   bun run db:push   (creates all tables)
DATABASE_URL=postgresql://nusword:nusword@localhost:5432/nusword
DIRECT_URL=postgresql://nusword:nusword@localhost:5432/nusword

# ─── Auth (JWT Secret — REQUIRED for production) ──────────────────────
# Generate with: openssl rand -hex 32
# In dev (unset or default), auth auto-passes with placeholder user.
JWT_SECRET=nusword-dev-secret-change-in-production

# ─── Encore Backend (optional) ─────────────────────────────────────────
# Point the frontend to the Encore backend API.
# Local Encore dev server runs on http://localhost:4000
# Encore Cloud runs on https://[app-name]-[env].encr.app
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Supabase Auth (optional, alternative to Next.js JWT auth) ─────────
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# ─── Mode Selection ────────────────────────────────────────────────────
# If NONE of the above are set, the app runs in "dev mode" — auth is
# auto-passed and the placeholder user (user@nusword.local) is used.
# This allows local development without any backend setup.
#
# Production checklist:
# 1. Create Neon project at https://neon.tech → get DATABASE_URL + DIRECT_URL
# 2. Set JWT_SECRET (openssl rand -hex 32)
# 3. Run: bun run db:push (creates tables in Neon)
# 4. Set all env vars in Vercel: DATABASE_URL, DIRECT_URL, JWT_SECRET
# 5. Deploy — auth + database work immediately
