# NUSWORD Environment Variables
#
# Copy this file to .env and fill in your values.
# The app supports THREE auth modes (checked in order):
#   1. Encore (if NEXT_PUBLIC_API_BASE_URL is set) — JWT auth via Encore backend
#   2. Supabase (if NEXT_PUBLIC_SUPABASE_URL is set) — Supabase auth
#   3. Dev mode (neither set) — auto-login with placeholder user

# ─── Database (PostgreSQL — REQUIRED for production) ───────────────────
#
# OPTION A: Local PostgreSQL via Docker (recommended for dev)
#   1. Run: docker compose up -d
#   2. Use the connection string below:
#
DATABASE_URL=postgresql://nusword:nusword@localhost:5432/nusword
#
# OPTION B: Supabase (recommended for production)
#   1. Create project at https://supabase.com
#   2. Go to Settings → Database → Connection string
#   3. Use the Transaction pooler URL (port 6543):
#
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# After setting DATABASE_URL, run:
#   bun run db:push   (creates all tables)

# ─── Encore Backend (optional) ─────────────────────────────────────────
# Point the frontend to the Encore backend API.
# Local Encore dev server runs on http://localhost:4000
# Encore Cloud runs on https://[app-name]-[env].encr.app
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Supabase Auth (optional, alternative to Encore) ───────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# ─── Mode Selection ────────────────────────────────────────────────────
# If NONE of the above are set, the app runs in "dev mode" — auth is
# auto-passed and the placeholder user (user@nusword.local) is used.
# This allows local development without any backend setup.
#
# To use Encore (recommended for production):
# 1. cd backend && encore run  (starts Encore on :4000)
# 2. Uncomment NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# 3. Restart the Next.js dev server
#
# To use Supabase (alternative):
# 1. Create a project at https://supabase.com
# 2. Uncomment the NEXT_PUBLIC_SUPABASE_* lines
# 3. Change DATABASE_URL to Supabase PostgreSQL
# 4. Run: bun run db:push
# 5. Restart the dev server
